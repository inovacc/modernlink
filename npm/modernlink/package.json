    "README.md",
    "NATIVE-INTEGRITY-MANIFEST.md"
  ],
  "optionalDependencies": {
    "@inovacc/modernlink-win32-x64": "0.1.0",
    "@inovacc/modernlink-linux-x64": "0.1.0",
    "@inovacc/modernlink-linux-arm64": "0.1.0",
    "@inovacc/modernlink-darwin-x64": "0.1.0",
    "@inovacc/modernlink-darwin-arm64": "0.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
